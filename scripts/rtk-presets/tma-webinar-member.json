  "ui": {
    "design_tokens": {
      "theme": "darkest",
      "font_family": "Inter",
      "border_radius": "rounded",
      "border_width": "thin",
      "colors": {
        "brand": {
          "300": "#fee38a",
          "400": "#fdd45a",
          "500": "#fdc921",
          "600": "#d9a90f",
          "700": "#b28a0a"
