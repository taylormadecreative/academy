        "background": {
          "600": "#22345f",
          "700": "#162650",
          "800": "#0f1d44",
          "900": "#0a1733",
          "1000": "#04123a"
        },
        "text": "#ffffff",
        "text_on_brand": "#04123a",
        "video_bg": "#0a1733",
        "danger": "#ff5c5c",
        "success": "#3ddc97",
        "warning": "#fdc921"
